{
  "name": "dialit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "db:migrate": "tsx scripts/migrate.ts",
    "setup": "node scripts/setup.mjs && npm run db:migrate",
    "test:smoke": "tsx --test tests/workflow.test.ts",
    "test": "tsx --test tests/*.test.ts",
    "moderator:create": "tsx scripts/create-moderator.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "test:browser": "playwright test",
    "session:restore": "tsx scripts/restore-session.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.6.1",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "idb": "^8.0.4",
    "multer": "^2.5.0",
    "next": "16.4.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "node-gyp": "12.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
